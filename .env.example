DATABASE_URL=postgresql+asyncpg://kobby:kobby@localhost:5432/kobby_manager
REDIS_URL=redis://localhost:6379/0

# Token encryption — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Base URL for OAuth callbacks (no trailing slash)
BASE_URL=http://localhost:8000

# Instagram (Meta Graph API)
META_APP_ID=
META_APP_SECRET=

# TikTok (Display API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

SECRET_KEY=change-me-in-production
CRON_SECRET=

# Clerk authentication and ChatGPT MCP OAuth
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# Optional overrides; otherwise derived from CLERK_JWKS_URL and BASE_URL.
CLERK_ISSUER=
MCP_RESOURCE_URL=
MCP_OAUTH_CLIENT_ID=https://chatgpt.com/oauth/client.json

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
